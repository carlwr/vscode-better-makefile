{
  "comments": {
    "lineComment": { "comment": "#", "noIndent": true }
  },
  "wordPattern": "[^\\`\\~\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\<\\>\\/\\?\\s]+",
  "brackets": [
    ["$(", ")"],
    ["(", ")"],
    ["${", "}"],
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["$(", ")"],
    ["(", ")"],
    ["${", "}"],
    ["{", "}"],
    ["[", "]"],
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "'", "close": "'", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*#region\\b",
      "end": "^\\s*#\\s*#endregion\\b"
    }
  }
}
