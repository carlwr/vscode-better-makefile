#!/usr/bin/env -S jq -r -f
# Print all scope names in a JSON grammar.
# The grammar may specify scopes with $ placeholders; these appear unexpanded.

del(.name)
| [
  (
    .scopeName,
    (.. | objects | (.name?, .contentName?) | select(. != null))
  )
  | scan("\\S+")
]
| unique
| sort_by(ascii_downcase)[]
