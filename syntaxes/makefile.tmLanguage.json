{
  "name": "Makefile",
  "scopeName": "source.makefile",
  "comment": "Originally authored by Carl Wernhoff. SPDX-License-Identifier: MIT\nCanonical source: https://github.com/carlwr/vscode-better-makefile/blob/main/src/makefile.tmLanguage.yaml\nPlease propose fixes and improvements in the upstream repository.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#variable-assignment"
    },
    {
      "include": "#rulehead"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#doubleDollar"
    },
    {
      "include": "#expansions"
    },
    {
      "include": "#recipe-line"
    }
  ],
  "repository": {
    "comma-condition": {
      "match": ",",
      "name": "punctuation.separator.delimiter.comma.condition.makefile"
    },
    "comma-funcargs": {
      "match": ",",
      "name": "punctuation.separator.delimiter.comma.function.makefile"
    },
    "comment": {
      "patterns": [
        {
          "include": "#quoted-hash"
        },
        {
          "include": "#comment-actual"
        }
      ],
      "repository": {
        "comment-actual": {
          "begin": "(?x)\n(     ^[ ]++       )?  # \"1\": if at BOL: any leading whitespace\n(?<!  \\\\           )   # otherwise unreliable \\ count -> don't match\n(     (?: \\\\{2} )*+)   # \"2\": any even no. of \\-s -> quoting \\-es\n(?=   \\#           )   # an (unquoted) # on next position",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.makefile"
            },
            "2": {
              "patterns": [
                {
                  "include": "#esc-backslashes"
                }
              ]
            }
          },
          "end": "(?!\\G)",
          "patterns": [
            {
              "begin": "\\#",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.makefile"
                }
              },
              "end": "(?=\\n)",
              "applyEndPatternLast": 1,
              "name": "comment.line.number-sign.makefile",
              "patterns": [
                {
                  "include": "#line-cont"
                }
              ]
            }
          ]
        },
        "quoted-hash": {
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#esc-backslashes"
                }
              ]
            },
            "2": {
              "name": "constant.character.escape.hash.makefile"
            }
          },
          "match": "(?x)\n(?<!    \\\\        )   # otherwise unreliable \\ count -> don't match\n(   (?: \\\\{2} )*+ )   # \"1\": any even no. of \\-s -> quoting \\-es\n       (\\\\\\#)         # \"2\": the quoted #"
        }
      }
    },
    "directives": {
      "patterns": [
        {
          "include": "#include-directive"
        },
        {
          "include": "#load"
        },
        {
          "include": "#vpath"
        },
        {
          "include": "#define"
        },
        {
          "include": "#export"
        },
        {
          "include": "#undefine"
        },
        {
          "include": "#override"
        },
        {
          "include": "#private"
        },
        {
          "include": "#unexport"
        },
        {
          "include": "#conditional"
        }
      ],
      "repository": {
        "condition": {
          "begin": "\\G(?<=ifeq|ifneq|ifdef|ifndef)",
          "end": "^",
          "name": "meta.scope.condition.makefile",
          "patterns": [
            {
              "include": "#condition-body"
            }
          ]
        },
        "condition-body": {
          "patterns": [
            {
              "include": "#condition-varname"
            },
            {
              "include": "#comma-condition"
            },
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#comment"
            }
          ]
        },
        "condition-varname": {
          "captures": {
            "1": {
              "name": "variable.other.makefile",
              "patterns": [
                {
                  "include": "#varname-parts"
                }
              ]
            }
          },
          "match": "(?x)\n\\G (?<= ifdef|ifndef )\n[ \\t]+\n( (?: [^\\s#\\\\]\n  |   \\\\ (?!\\n)   # a \\ ending the line continues it\n  )+\n)"
        },
        "conditional": {
          "begin": "^\\s*(ifeq|ifneq|ifdef|ifndef)(?=\\s)",
          "captures": {
            "1": {
              "name": "keyword.control.$1.makefile"
            }
          },
          "end": "^\\s*(endif)\\b",
          "name": "meta.scope.conditional.makefile",
          "patterns": [
            {
              "include": "#condition"
            },
            {
              "begin": "^\\s*(else)(?=\\s)(?:\\s+(ifeq|ifneq|ifdef|ifndef)(?=\\s))?",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.else.makefile"
                },
                "2": {
                  "name": "keyword.control.$2.makefile"
                }
              },
              "end": "^",
              "patterns": [
                {
                  "include": "#condition"
                },
                {
                  "include": "#condition-body"
                }
              ]
            },
            {
              "include": "$self"
            }
          ]
        },
        "define": {
          "begin": "(?x)\n^\n\\s*+  (                    # \"1\", optional\n        (?: (?: override\n            ) [\\ \\t]++\n        )*+\n      )\n    (\\b define   \\b)       # \"2\", required\n\\s*   (                    # \"3\", required\n        (?: [^\\s#=!+?:]++    # >=1 of the subsequences\n        |   ! (?!    =)\n        |  \\+ (?!    =)\n        |  \\? (?!    =)\n        |   : (?!:?:?=)\n        )++\n      )\n\\s*   (                    # \"4\", optional\n        (?: [!+?]            # optional prefix...\n        |   :{0,3}\n        )\n        =                    # ...and \"=\"\n      )?",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.override.makefile"
            },
            "2": {
              "name": "keyword.control.define.makefile"
            },
            "3": {
              "name": "variable.other.assignment.makefile",
              "patterns": [
                {
                  "include": "#varname-parts"
                }
              ]
            },
            "4": {
              "name": "keyword.operator.assignment.makefile"
            }
          },
          "end": "^\\s*(endef)\\b",
          "endCaptures": {
            "1": {
              "name": "keyword.control.endef.makefile"
            }
          },
          "name": "meta.scope.define.makefile",
          "patterns": [
            {
              "begin": "\\G(?!^)",
              "end": "^",
              "patterns": [
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^",
              "end": "^(?=\\s*(endef)\\b)",
              "name": "meta.scope.define.body.makefile",
              "patterns": [
                {
                  "include": "#define"
                },
                {
                  "include": "#define-body"
                }
              ]
            }
          ]
        },
        "define-body": {
          "patterns": [
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "match": "[^\\$]+",
              "name": "meta.string.makefile string.unquoted.makefile"
            },
            {
              "match": ".",
              "name": "meta.string.makefile string.unquoted.makefile"
            }
          ]
        },
        "directive-varname": {
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#varname-specialVar"
                }
              ]
            }
          },
          "match": "\\S+",
          "name": "variable.other.makefile"
        },
        "export": {
          "begin": "^[ ]*(export)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.export.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#variable-assignment"
            },
            {
              "include": "#directive-varname"
            }
          ]
        },
        "include-directive": {
          "begin": "^[ ]*([s\\-]?include)(?=[ \\t])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.include.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#percent"
            },
            {
              "match": "(?x)\n  [^\\s$#\\\\%:()]++   # chars possibly special to the including rule...\n| \\S                # ...are path chars if that rule doesn't match them first",
              "name": "meta.string.makefile string.unquoted.path.makefile"
            }
          ]
        },
        "load": {
          "patterns": [
            {
              "begin": "^[ ]*([-]?load)(?=[ \\t])",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.load.makefile"
                }
              },
              "end": "^",
              "patterns": [
                {
                  "include": "#comment"
                },
                {
                  "include": "#load-symbolname"
                },
                {
                  "include": "#doubleDollar"
                },
                {
                  "include": "#expansions"
                },
                {
                  "match": "(?x)\n  [^\\s$#\\\\%:()]++   # chars possibly special to the including rule...\n| \\S                # ...are path chars if that rule doesn't match them first",
                  "name": "meta.string.makefile string.unquoted.path.makefile"
                }
              ]
            }
          ],
          "repository": {
            "load-symbolname": {
              "applyEndPatternLast": 1,
              "begin": "(?x) \\(",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.parameters.load-symbolname.makefile punctuation.section.load-symbolname.makefile"
                }
              },
              "contentName": "meta.scope.load-symbolname.makefile",
              "end": "(?x) \\) | (?=\\n)",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.parameters.load-symbolname.makefile punctuation.section.load-symbolname.makefile"
                }
              },
              "patterns": [
                {
                  "include": "#doubleDollar"
                },
                {
                  "include": "#expansions"
                },
                {
                  "include": "#line-cont"
                }
              ]
            }
          }
        },
        "override": {
          "begin": "^[ ]*(override)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.override.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#variable-assignment"
            }
          ]
        },
        "private": {
          "begin": "^[ ]*(private)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.private.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#variable-assignment"
            }
          ]
        },
        "undefine": {
          "begin": "^[ ]*+(override\\b)?[ \\t]*+(undefine)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.override.makefile"
            },
            "2": {
              "name": "keyword.control.undefine.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#directive-varname"
            }
          ]
        },
        "unexport": {
          "begin": "^[ ]*(unexport)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.unexport.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#variable-assignment"
            },
            {
              "include": "#directive-varname"
            }
          ]
        },
        "vpath": {
          "begin": "^[ ]*(vpath)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.vpath.makefile"
            }
          },
          "end": "^",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#percent"
            },
            {
              "match": ":",
              "name": "punctuation.separator.paths.vpath.makefile"
            },
            {
              "match": "(?x)\n  [^\\s$#\\\\%:()]++   # chars possibly special to the including rule...\n| \\S                # ...are path chars if that rule doesn't match them first",
              "name": "meta.string.makefile string.unquoted.path.makefile"
            }
          ]
        }
      }
    },
    "doubleDollar": {
      "match": "(\\$\\$)+",
      "name": "constant.character.escape.dollar.makefile"
    },
    "esc-backslashes": {
      "patterns": [
        {
          "match": "\\\\\\\\",
          "name": "constant.character.escape.backslash.makefile"
        }
      ]
    },
    "expansions": {
      "patterns": [
        {
          "include": "#expansions_$c_"
        },
        {
          "include": "#expansions_pp_"
        },
        {
          "include": "#expansions_bb_"
        }
      ]
    },
    "expansions--func-builtin-NESTED": {
      "patterns": [
        {
          "include": "#expansions--func-builtin-NESTED_pp_"
        },
        {
          "include": "#expansions--func-builtin-NESTED_bb_"
        }
      ],
      "repository": {
        "expansions--func-builtin-NESTED_bb_": {
          "applyEndPatternLast": 1,
          "begin": "(?x) \\{",
          "beginCaptures": {
            "0": {
              "name": "meta.string.makefile string.unquoted.makefile"
            }
          },
          "end": "(?x) \\} | (?=\\n)",
          "endCaptures": {
            "0": {
              "name": "meta.string.makefile string.unquoted.makefile"
            }
          },
          "name": "meta.function-call.braces-group.makefile",
          "patterns": [
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#expansions--func-builtin-NESTED"
            },
            {
              "include": "#line-cont"
            },
            {
              "match": "(?x) ((?:        [^\\\\$\\n{}(] | \\\\(?!\\\\*\\n) )+)",
              "captures": {
                "1": {
                  "name": "meta.string.makefile string.unquoted.makefile"
                }
              }
            }
          ]
        },
        "expansions--func-builtin-NESTED_pp_": {
          "applyEndPatternLast": 1,
          "begin": "(?x) \\(",
          "beginCaptures": {
            "0": {
              "name": "meta.string.makefile string.unquoted.makefile"
            }
          },
          "end": "(?x) \\) | (?=\\n)",
          "endCaptures": {
            "0": {
              "name": "meta.string.makefile string.unquoted.makefile"
            }
          },
          "name": "meta.function-call.parens-group.makefile",
          "patterns": [
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#expansions--func-builtin-NESTED"
            },
            {
              "include": "#line-cont"
            },
            {
              "match": "(?x) ((?:        [^\\\\$\\n(){] | \\\\(?!\\\\*\\n) )+)",
              "captures": {
                "1": {
                  "name": "meta.string.makefile string.unquoted.makefile"
                }
              }
            }
          ]
        }
      }
    },
    "expansions_$c_": {
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#varname-automatic"
            },
            {
              "include": "#varname-positional"
            },
            {
              "include": "#varname-userSingleChar"
            }
          ]
        }
      },
      "match": "\\$[^({$#\\n ]"
    },
    "expansions_bb_": {
      "patterns": [
        {
          "begin": "(?x) \\$\\{",
          "end": "(?x)   \\} | (?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.makefile"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.makefile"
            }
          },
          "contentName": "meta.scope.expansion.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "include": "#line-cont"
            },
            {
              "include": "#expansions_bb_func-builtin_multiary"
            },
            {
              "include": "#expansions_bb_func-builtin_varUnary"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#varname-specialVar"
            },
            {
              "include": "#varname-automatic"
            },
            {
              "include": "#varname-positional"
            },
            {
              "include": "#substref-segment"
            },
            {
              "include": "#varname-segment"
            },
            {
              "match": "\\)",
              "name": "variable.other.makefile"
            }
          ]
        }
      ]
    },
    "expansions_bb_func-builtin_multiary": {
      "patterns": [
        {
          "begin": "(?x)\n\\G\n(?# built-in functions -> )\n(?# ref.: function.c -> struct function_table_entry + guile)\n( abspath\n| addprefix\n| addsuffix\n| and\n| basename\n| call\n| dir\n| error\n| eval\n| file\n| filter\n| filter-out\n| findstring\n| firstword\n| foreach\n| guile\n| if\n| info\n| intcmp\n| join\n| lastword\n| let\n| notdir\n| or\n| patsubst\n| realpath\n| shell\n| sort\n| strip\n| subst\n| suffix\n| warning\n| wildcard\n| word\n| wordlist\n| words\n)\n(?=[ \\\\])\n(?:\\s*)    # eat any space following the function name",
          "end": "(?x) (?= \\}) | (?=\\n)",
          "beginCaptures": {
            "1": {
              "name": "support.function.$1.makefile"
            }
          },
          "name": "meta.function-call.makefile",
          "contentName": "meta.function-call.arguments.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "include": "#comma-funcargs"
            },
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#expansions--func-builtin-NESTED"
            },
            {
              "include": "#line-cont"
            },
            {
              "match": "(?x) ((?:       [^,\\\\$\\n{}(] | \\\\(?!\\\\*\\n) )+)",
              "captures": {
                "1": {
                  "name": "meta.string.makefile string.unquoted.makefile"
                }
              }
            }
          ]
        }
      ]
    },
    "expansions_bb_func-builtin_varUnary": {
      "patterns": [
        {
          "begin": "(?x)\n\\G\n( flavor\n| origin\n| value\n)\n(?=[ \\\\])\n(?:\\s*)",
          "end": "(?x) (?= \\}) | (?=\\n)",
          "beginCaptures": {
            "1": {
              "name": "support.function.$1.makefile"
            }
          },
          "name": "meta.function-call.makefile",
          "contentName": "meta.function-call.arguments.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "match": "(?x) ((?:        [^\\\\$\\n{}(] | \\\\(?!\\\\*\\n) )+)",
              "captures": {
                "1": {
                  "name": "variable.other.makefile"
                }
              }
            }
          ]
        }
      ]
    },
    "expansions_pp_": {
      "patterns": [
        {
          "begin": "(?x) \\$\\(",
          "end": "(?x)   \\) | (?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.makefile"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.makefile"
            }
          },
          "contentName": "meta.scope.expansion.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "include": "#line-cont"
            },
            {
              "include": "#expansions_pp_func-builtin_multiary"
            },
            {
              "include": "#expansions_pp_func-builtin_varUnary"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#varname-specialVar"
            },
            {
              "include": "#varname-automatic"
            },
            {
              "include": "#varname-positional"
            },
            {
              "include": "#substref-segment"
            },
            {
              "include": "#varname-segment"
            },
            {
              "match": "\\}",
              "name": "variable.other.makefile"
            }
          ]
        }
      ]
    },
    "expansions_pp_func-builtin_multiary": {
      "patterns": [
        {
          "begin": "(?x)\n\\G\n(?# built-in functions -> )\n(?# ref.: function.c -> struct function_table_entry + guile)\n( abspath\n| addprefix\n| addsuffix\n| and\n| basename\n| call\n| dir\n| error\n| eval\n| file\n| filter\n| filter-out\n| findstring\n| firstword\n| foreach\n| guile\n| if\n| info\n| intcmp\n| join\n| lastword\n| let\n| notdir\n| or\n| patsubst\n| realpath\n| shell\n| sort\n| strip\n| subst\n| suffix\n| warning\n| wildcard\n| word\n| wordlist\n| words\n)\n(?=[ \\\\])\n(?:\\s*)    # eat any space following the function name",
          "end": "(?x) (?= \\)) | (?=\\n)",
          "beginCaptures": {
            "1": {
              "name": "support.function.$1.makefile"
            }
          },
          "name": "meta.function-call.makefile",
          "contentName": "meta.function-call.arguments.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "include": "#comma-funcargs"
            },
            {
              "include": "#doubleDollar"
            },
            {
              "include": "#expansions"
            },
            {
              "include": "#expansions--func-builtin-NESTED"
            },
            {
              "include": "#line-cont"
            },
            {
              "match": "(?x) ((?:       [^,\\\\$\\n(){] | \\\\(?!\\\\*\\n) )+)",
              "captures": {
                "1": {
                  "name": "meta.string.makefile string.unquoted.makefile"
                }
              }
            }
          ]
        }
      ]
    },
    "expansions_pp_func-builtin_varUnary": {
      "patterns": [
        {
          "begin": "(?x)\n\\G\n( flavor\n| origin\n| value\n)\n(?=[ \\\\])\n(?:\\s*)",
          "end": "(?x) (?= \\)) | (?=\\n)",
          "beginCaptures": {
            "1": {
              "name": "support.function.$1.makefile"
            }
          },
          "name": "meta.function-call.makefile",
          "contentName": "meta.function-call.arguments.makefile",
          "applyEndPatternLast": 1,
          "patterns": [
